# Servidor
PORT=3000
# Origenes permitidos para CORS (separados por coma) o * para todos
CORS_ORIGIN=*

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rosa_bonita

# Autenticacion: usa una frase larga y aleatoria (minimo 16 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Administrador inicial (se crea al ejecutar npm run initDB)
ADMIN_EMAIL=admin@rosabonita.com
ADMIN_PASSWORD=
